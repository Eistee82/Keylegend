{
  "$schema": "../schema.json",
  "formatVersion": 1,
  "id": "libreoffice-calc",
  "name": "LibreOffice Calc",
  "kind": "app",

  "match": {
    "processes": ["soffice", "soffice.bin"],
    "titleContains": ["LibreOffice Calc"],
    "priority": 10
  },

  "shortcuts": {
    "Ctrl": {
      "characters": {
        "n": { "group": "File", "label": "New document" },
        "o": { "group": "File", "label": "Open document" },
        "s": { "group": "File", "label": "Save" },
        "p": { "group": "File", "label": "Print" },
        "w": { "group": "File", "label": "Close window" },
        "q": { "group": "File", "label": "Exit LibreOffice" },
        "z": { "group": "Edit", "label": "Undo" },
        "y": { "group": "Edit", "label": "Redo" },
        "x": { "group": "Edit", "label": "Cut" },
        "c": { "group": "Edit", "label": "Copy" },
        "v": { "group": "Edit", "label": "Paste" },
        "a": { "group": "Edit", "label": "Select all" },
        "f": { "group": "Search", "label": "Find" },
        "h": { "group": "Search", "label": "Find and replace" },
        "b": { "group": "Edit", "label": "Bold" },
        "i": { "group": "Edit", "label": "Italic" },
        "u": { "group": "Edit", "label": "Underline" },
        "d": { "group": "Edit", "label": "Fill down from cell above" },
        "1": { "group": "Edit", "label": "Format cells dialog" },
        "+": { "group": "Edit", "label": "Insert cells" },
        "-": { "group": "Edit", "label": "Delete cells" }
      },
      "keys": {
        "Keyboard_Home": { "group": "Navigation", "label": "Go to cell A1" },
        "Keyboard_End": { "group": "Navigation", "label": "Go to last cell with data" },
        "Keyboard_ArrowUp": { "group": "Navigation", "label": "Jump to top edge of data region" },
        "Keyboard_ArrowDown": { "group": "Navigation", "label": "Jump to bottom edge of data region" },
        "Keyboard_ArrowLeft": { "group": "Navigation", "label": "Jump to left edge of data region" },
        "Keyboard_ArrowRight": { "group": "Navigation", "label": "Jump to right edge of data region" },
        "Keyboard_PageUp": { "group": "Window", "label": "Previous sheet" },
        "Keyboard_PageDown": { "group": "Window", "label": "Next sheet" },
        "Keyboard_Enter": { "group": "Edit", "label": "Start a new line inside the cell" },
        "Keyboard_Space": { "group": "Edit", "label": "Select entire column" },
        "Keyboard_F8": { "group": "View", "label": "Value highlighting" }
      }
    },

    "Ctrl+Shift": {
      "characters": {
        "s": { "group": "File", "label": "Save as" },
        "v": { "group": "Edit", "label": "Paste special" },
        "l": { "group": "Search", "label": "Turn AutoFilter on or off" }
      },
      "keys": {
        "Keyboard_Home": { "group": "Edit", "label": "Extend selection to cell A1" },
        "Keyboard_End": { "group": "Edit", "label": "Extend selection to last cell with data" },
        "Keyboard_ArrowUp": { "group": "Edit", "label": "Extend selection to top edge of data" },
        "Keyboard_ArrowDown": { "group": "Edit", "label": "Extend selection to bottom edge of data" },
        "Keyboard_ArrowLeft": { "group": "Edit", "label": "Extend selection to left edge of data" },
        "Keyboard_ArrowRight": { "group": "Edit", "label": "Extend selection to right edge of data" }
      }
    },

    "Alt": {
      "keys": {
        "Keyboard_Enter": { "group": "Edit", "label": "Fill selected range with the entry" }
      }
    }
  }
}
