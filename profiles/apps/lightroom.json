{
  "$schema": "../schema.json",
  "formatVersion": 1,
  "id": "lightroom",
  "name": "Adobe Lightroom Classic",
  "kind": "app",

  "match": {
    "processes": ["lightroom", "adobe lightroom"],
    "priority": 10
  },

  "highlights": {
    "Keyboard_G": { "colour": "#00C8FF", "label": "Grid view" },
    "Keyboard_E": { "colour": "#00C8FF", "label": "Loupe view" },
    "Keyboard_C": { "colour": "#00C8FF", "label": "Compare view" },
    "Keyboard_N": { "colour": "#00C8FF", "label": "Survey view" },
    "Keyboard_D": { "colour": "#00C8FF", "label": "Develop module" },
    "Keyboard_F": { "colour": "#00C8FF", "label": "Full screen preview" },
    "Keyboard_L": { "colour": "#00C8FF", "label": "Lights out" },

    "Keyboard_R": { "colour": "#FFC800", "label": "Crop" },
    "Keyboard_Q": { "colour": "#FFC800", "label": "Spot removal" },
    "Keyboard_V": { "colour": "#FFC800", "label": "Convert to black and white" },
    "Keyboard_J": { "colour": "#FFC800", "label": "Show clipping" },
    "Keyboard_Z": { "colour": "#FFC800", "label": "Before and after side by side" },
    "Keyboard_Y": { "colour": "#FFC800", "label": "Toggle zoom" },

    "Keyboard_P": { "colour": "#00FF64", "label": "Flag as pick" },
    "Keyboard_X": { "colour": "#00FF64", "label": "Flag as rejected" },
    "Keyboard_U": { "colour": "#00FF64", "label": "Remove flag" },
    "Keyboard_B": { "colour": "#00FF64", "label": "Add to quick collection" },
    "Keyboard_0": { "colour": "#00FF64", "label": "No rating" },
    "Keyboard_1": { "colour": "#00FF64", "label": "One star" },
    "Keyboard_2": { "colour": "#00FF64", "label": "Two stars" },
    "Keyboard_3": { "colour": "#00FF64", "label": "Three stars" },
    "Keyboard_4": { "colour": "#00FF64", "label": "Four stars" },
    "Keyboard_5": { "colour": "#00FF64", "label": "Five stars" },
    "Keyboard_6": { "colour": "#00FF64", "label": "Red label" },
    "Keyboard_7": { "colour": "#00FF64", "label": "Yellow label" },
    "Keyboard_8": { "colour": "#00FF64", "label": "Green label" },
    "Keyboard_9": { "colour": "#00FF64", "label": "Blue label" },

    "Keyboard_Tab": { "colour": "#B4B4B4", "label": "Hide side panels" }
  },

  "shortcuts": {
    "Ctrl": {
      "characters": {
        "n": { "group": "File", "label": "New collection" },
        "s": { "group": "File", "label": "Save metadata to file" },
        "p": { "group": "File", "label": "Print" },
        "e": { "group": "File", "label": "Edit in Photoshop" },
        "r": { "group": "File", "label": "Show in Explorer" },
        "z": { "group": "Edit", "label": "Undo" },
        "c": { "group": "Edit", "label": "Copy" },
        "v": { "group": "Edit", "label": "Paste" },
        "a": { "group": "Edit", "label": "Select all" },
        "d": { "group": "Edit", "label": "Deselect all" },
        "g": { "group": "Edit", "label": "Group into stack" },
        "u": { "group": "Tools", "label": "Auto tone" },
        "+": { "group": "View", "label": "Zoom in" },
        "-": { "group": "View", "label": "Zoom out" },
        ",": { "group": "System", "label": "Preferences" }
      }
    },

    "Ctrl+Shift": {
      "characters": {
        "i": { "group": "File", "label": "Import photos" },
        "e": { "group": "File", "label": "Export photos" },
        "c": { "group": "Edit", "label": "Copy develop settings" },
        "v": { "group": "Edit", "label": "Paste develop settings" },
        "u": { "group": "Tools", "label": "Auto white balance" }
      }
    }
  }
}
