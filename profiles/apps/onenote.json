{
  "$schema": "../schema.json",
  "formatVersion": 1,
  "id": "onenote",
  "name": "Microsoft OneNote",
  "kind": "app",

  "match": {
    "processes": ["onenote", "onenoteim"],
    "priority": 10
  },

  "shortcuts": {
    "Ctrl": {
      "characters": {
        "n": { "group": "File", "label": "New page" },
        "t": { "group": "File", "label": "New section" },
        "o": { "group": "File", "label": "Open notebook" },
        "p": { "group": "File", "label": "Print" },
        "z": { "group": "Edit", "label": "Undo" },
        "y": { "group": "Edit", "label": "Redo" },
        "x": { "group": "Edit", "label": "Cut" },
        "c": { "group": "Edit", "label": "Copy" },
        "v": { "group": "Edit", "label": "Paste" },
        "a": { "group": "Edit", "label": "Select all" },
        "f": { "group": "Search", "label": "Search on this page" },
        "e": { "group": "Search", "label": "Search all notebooks" },
        "b": { "group": "Edit", "label": "Bold" },
        "i": { "group": "Edit", "label": "Italic" },
        "u": { "group": "Edit", "label": "Underline" },
        "k": { "group": "Edit", "label": "Insert hyperlink" },
        "m": { "group": "Window", "label": "New OneNote window" },
        "1": { "group": "Tools", "label": "Apply To Do tag" },
        "2": { "group": "Tools", "label": "Apply Important tag" },
        "3": { "group": "Tools", "label": "Apply Question tag" },
        "0": { "group": "Tools", "label": "Remove all tags" },
        ".": { "group": "Edit", "label": "Bulleted list" }
      },
      "keys": {
        "Keyboard_PageUp": { "group": "Navigation", "label": "Previous page in section" },
        "Keyboard_PageDown": { "group": "Navigation", "label": "Next page in section" },
        "Keyboard_Tab": { "group": "Window", "label": "Next section" },
        "Keyboard_ArrowLeft": { "group": "Navigation", "label": "Word left" },
        "Keyboard_ArrowRight": { "group": "Navigation", "label": "Word right" }
      }
    },

    "Ctrl+Shift": {
      "characters": {
        "m": { "group": "File", "label": "New quick note window" },
        "n": { "group": "Edit", "label": "Apply Normal style" }
      },
      "keys": {
        "Keyboard_Tab": { "group": "Window", "label": "Previous section" }
      }
    },

    "Ctrl+Alt": {
      "characters": {
        "1": { "group": "Edit", "label": "Apply Heading 1 style" },
        "2": { "group": "Edit", "label": "Apply Heading 2 style" },
        "3": { "group": "Edit", "label": "Apply Heading 3 style" }
      }
    }
  }
}
