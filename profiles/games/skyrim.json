{
  "$schema": "../schema.json",
  "formatVersion": 1,
  "id": "skyrim",
  "name": "The Elder Scrolls V: Skyrim",
  "kind": "game",

  "match": {
    "processes": ["skyrimse", "skyrim", "tesv", "skyrimvr"],
    "appliesToGames": false,
    "priority": 10
