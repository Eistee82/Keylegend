    "Keyboard_1": { "colour": "#00C8FF", "label": "Toolbar slot 1" },
    "Keyboard_2": { "colour": "#00C8FF", "label": "Toolbar slot 2" },
    "Keyboard_3": { "colour": "#00C8FF", "label": "Toolbar slot 3" },
    "Keyboard_4": { "colour": "#00C8FF", "label": "Toolbar slot 4" },
