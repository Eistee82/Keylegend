{
  "$schema": "../schema.json",
  "formatVersion": 1,
  "id": "world-of-warcraft",
  "name": "World of Warcraft",
  "kind": "game",

  "match": {
    "processes": ["wow", "wowclassic", "wow-64"],
    "appliesToGames": false,
    "priority": 10
  },

  "highlights": {
    "Keyboard_W": { "colour": "#FF0000", "label": "Move forward" },
    "Keyboard_S": { "colour": "#FF0000", "label": "Move backward" },
    "Keyboard_A": { "colour": "#FF0000", "label": "Turn left" },
    "Keyboard_D": { "colour": "#FF0000", "label": "Turn right" },
    "Keyboard_Q": { "colour": "#FF0000", "label": "Strafe left" },
    "Keyboard_E": { "colour": "#FF0000", "label": "Strafe right" },

    "Keyboard_Space": { "colour": "#FF8C00", "label": "Jump" },
    "Keyboard_X": { "colour": "#FF8C00", "label": "Sit or stand" },
    "Keyboard_NumLock": { "colour": "#FF8C00", "label": "Auto-run" },
    "Keyboard_Tab": { "colour": "#FF8C00", "label": "Target nearest enemy" },

    "Keyboard_1": { "colour": "#00C8FF", "label": "Action bar slot 1" },
    "Keyboard_2": { "colour": "#00C8FF", "label": "Action bar slot 2" },
