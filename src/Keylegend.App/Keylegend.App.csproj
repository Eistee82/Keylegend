<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For the notification-area icon, which WPF has no equivalent for. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Keylegend</AssemblyName>
    <RootNamespace>Keylegend.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- What Explorer, the taskbar and Alt-Tab show. Generated by tools/make-icon.py. -->
    <ApplicationIcon>keylegend.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    The same file again as a resource: the executable's icon is not readable from inside the
    process, so the window and the notification-area icon load it from here.
  -->
  <ItemGroup>
    <Resource Include="keylegend.ico" />

    <!--
      The donation buttons, each taken from the service that publishes it - PayPal's from
      paypalobjects.com, Ko-fi's from storage.ko-fi.com. Using the artwork each service provides
      for this purpose, rather than drawing something that resembles it.
    -->
    <Resource Include="Assets\paypal-donate.gif" />
    <Resource Include="Assets\kofi-button.png" />
  </ItemGroup>

  <!--
    WinForms is referenced only for the notification-area icon, but its implicit usings pull in
    System.Drawing and System.Windows.Forms everywhere - which collide with WPF over Brush,
    Size, KeyEventArgs and more. Removing them keeps the WPF code unambiguous; TrayIcon.cs
    imports what it needs under an alias.
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keylegend.Core\Keylegend.Core.csproj" />
    <ProjectReference Include="..\Keylegend.Chroma\Keylegend.Chroma.csproj" />
    <ProjectReference Include="..\Keylegend.Windows\Keylegend.Windows.csproj" />
    <ProjectReference Include="..\Keylegend.Engine\Keylegend.Engine.csproj" />
  </ItemGroup>


  <!--
    The device profiles, copied next to the binaries. Without this a published copy has no
    devices folder at all: DeviceProfileLocator walks up from the executable looking for one,
    finds nothing outside the repository, and the application refuses to start. That is invisible
    during development, where the repository's own folder is always a few levels up, and fatal
    everywhere else.

    Application profiles need no equivalent — they are embedded resources in Keylegend.Core.
  -->
  <ItemGroup>
    <Content Include="..\..\devices\**\device.json"
             Link="devices\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
