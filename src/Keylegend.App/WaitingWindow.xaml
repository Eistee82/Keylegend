<Window x:Class="Keylegend.App.WaitingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Keylegend.App.Localisation"
        Title="Keylegend" Icon="keylegend.ico"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        Background="#141418" Foreground="#E8E8EE"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8EE" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,22,24,24">
        <!-- Amber rather than red, and for the same reason as the status line in the main
             window: the program is retrying by itself, so this says "not yet", not "gone". -->
        <TextBlock Text="{loc:Text WaitingHeading}"
                   FontSize="16" FontWeight="SemiBold" Foreground="#FFB454" />

        <!-- Which of the reasons applies is decided per look, so this one is written in code. -->
        <TextBlock x:Name="Reason" FontSize="12" Foreground="#C8C8D4" Margin="0,14,0,0" />

        <TextBlock Text="{loc:Text WaitingRetrying}"
                   FontSize="12" Foreground="#9A9AA8" Margin="0,12,0,0" />

        <TextBlock x:Name="LastAttempt" FontSize="11" Foreground="#6E6E7C" Margin="0,16,0,0" />
    </StackPanel>
</Window>
